### Get all products (public - no token needed)
GET {{host}}/api/products

### Delete without a token (expect 401 Unauthorized)
DELETE {{host}}/api/products/3

### Login to get a token
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Login with wrong password (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong"
}

### Create a product with the token (expect 201)
POST {{host}}/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Laptop Stand",
  "sku": "LS-005",
  "price": 7500,
  "quantityInStock": 25,
  "reorderLevel": 5
}